{
  "name": "cyber-ew-fusion-cell",
  "version": "1.1.0",
  "type": "module",
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.ts"],
    "moduleFileExtensions": ["ts", "js", "json", "node"]
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
      "start": "node dist/server.cjs",
      "test": "jest --coverage --runInBand --detectOpenHandles",
      "test:watch": "jest --watch"
    },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "cors": "^2.8.6",
    "d3": "^7.9.0",
    "express": "^5.2.1",
    "lucide-react": "^1.34.0",
    "motion": "^13.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@types/d3": "^7.4.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^4.9.5",
      "vite": "^8.2.2",
      "jest": "^29.0.0",
      "ts-jest": "^29.0.0",
      "@types/jest": "^29.0.0",
      "supertest": "^6.3.3",
      "@types/supertest": "^2.0.12"
    }
}